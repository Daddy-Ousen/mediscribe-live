# AssemblyAI Production API Key
# Required for minting temporary WebSocket tokens (Voice Agent & Real-time STT)
# and LLM Gateway clinical summarization.
# Get your API key from: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional: AssemblyAI LLM Gateway model used for SOAP notes.
# Default: qwen3.5-4b-32k-fast (available on every account).
# SOAP_MODEL=claude-sonnet-5
